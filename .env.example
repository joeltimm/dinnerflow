# Iron Skillet — Environment Variables
# Copy this file to .env and fill in your values.

# ── Database ──────────────────────────────────────────────────────────────────
DINNER_DB_NAME=dinnerflow
DINNER_DB_USER=dinneruser
DINNER_DB_PASSWORD=changeme

# ── Security ──────────────────────────────────────────────────────────────────
# Fernet key for encrypting Todoist API tokens in the database.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Secret key for signing 'Add to My Recipes' links in meal plan emails.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ── LLM (local OpenAI-compatible endpoint) ────────────────────────────────────
# Point at your local LLM server (LM Studio, Ollama openai-compat, etc.)
LLM_BASE_URL=http://your-llm-host:8081/v1
LLM_MODEL=gpt-4o-mini

# Embedding model for semantic search + duplicate detection (served by the same
# OpenAI-compatible endpoint). nomic-embed-text-v1.5 outputs 768 dims; if you use
# a different model, set EMBED_DIM to match and update migration 005 / the schema.
EMBED_MODEL=nomic-embed-text-v1.5-q5_k_m
# EMBED_DIM=768

# ── Tavily (web search for recipe ideas) ──────────────────────────────────────
# Get a free key at https://tavily.com
TAVILY_API_KEY=

# ── Email (SMTP relay) ────────────────────────────────────────────────────────
# Outbound mail goes through an SMTP relay — e.g. a host Postfix that smarthosts
# via Gmail. Reached over the Docker host-gateway; STARTTLS is used if offered.
# SMTP_FROM must be a verified send-as address for your domain.
SMTP_HOST=host.docker.internal
SMTP_PORT=25
SMTP_FROM=noreply@your-domain

# ── Gmail API (legacy — superseded by the SMTP relay above; leave unset) ──────
# Only needed if you revert services/email.py to the Gmail API path.
# SENDER_EMAIL=you@gmail.com
# GOOGLE_AUTH_HOST_PATH=/path/to/google_auth   # token_{suffix}.json dir (gmail.send scope)

# ── Host paths (mounted into containers by compose.yml) ──────────────────────

# Directory for recipe image uploads (persisted on host).
# Defaults to ./uploads if not set.
# UPLOADS_HOST_PATH=./uploads

# ── Redis (Celery broker) ─────────────────────────────────────────────────────
# Used by Celery for background tasks (email, meal plans, session cleanup).
# The compose.yml sets this automatically; override here only for non-Docker dev.
# REDIS_URL=redis://redis:6379/0

# ── Database pool ─────────────────────────────────────────────────────────────
# Max DB connections in the pool (default 50). Increase if running many workers.
# DB_POOL_MAX=50

# ── App ───────────────────────────────────────────────────────────────────────
# Public base URL — used to build clickable links in emails
APP_BASE_URL=https://ironskillet.joeltimm.dev

# CORS: space-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost http://localhost:5173 https://ironskillet.joeltimm.dev
